{
  "name": "@qrcommunication/viva-cloud-terminal-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Viva Wallet Cloud Terminal API (merchant /ecr/v1/) — drive a physical EFT POS terminal: sale, pre-auth capture, refunds, sessions and polling. OAuth2 client_credentials.",
  "keywords": [
    "viva",
    "viva-wallet",
    "vivapayments",
    "cloud-terminal",
    "eft-pos",
    "ecr",
    "payments",
    "pos",
    "sdk",
    "api",
    "typescript"
  ],
  "homepage": "https://github.com/QrCommunication/sdk-js-viva-cloud-terminal",
  "bugs": {
    "url": "https://github.com/QrCommunication/sdk-js-viva-cloud-terminal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QrCommunication/sdk-js-viva-cloud-terminal.git"
  },
  "license": "MIT",
  "author": {
    "name": "QrCommunication",
    "email": "contact@qrcommunication.com",
    "url": "https://qrcommunication.com"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
